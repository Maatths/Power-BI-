// =====================================================================
//  Panorama de Reclamações em Telecom (Anatel) — Tabela calendário e medidas DAX
//  Dica: crie uma tabela vazia "_Medidas" (Inserir dados > OK) e guarde as medidas nela.
// =====================================================================


// ---------------------------------------------------------------------
// TABELA CALCULADA: dCalendario
// Modelagem > Nova tabela. Depois: Marcar como tabela de datas (coluna Data).
// ---------------------------------------------------------------------
dCalendario =
VAR _Inicio = DATE ( YEAR ( MIN ( fReclamacoes[Data] ) ), 1, 1 )
VAR _Fim    = DATE ( YEAR ( MAX ( fReclamacoes[Data] ) ), 12, 31 )
RETURN
    ADDCOLUMNS (
        CALENDAR ( _Inicio, _Fim ),
        "Ano", YEAR ( [Date] ),
        "MesNum", MONTH ( [Date] ),
        "Mes", FORMAT ( [Date], "mmm" ),
        "AnoMes", FORMAT ( [Date], "yyyy-mm" ),
        "Trimestre", "T" & QUARTER ( [Date] ),
        "Semestre", IF ( MONTH ( [Date] ) <= 6, "S1", "S2" )
    )
// Renomeie a coluna [Date] para "Data" e classifique "Mes" pela coluna "MesNum".


// ---------------------------------------------------------------------
// RELACIONAMENTOS (Exibição de modelo) — todos 1:* com filtro único
//   dCalendario[Data]          -> fReclamacoes[Data]
//   dLocal[CodMunicipio]       -> fReclamacoes[CodMunicipio]
//   dOperadora[Marca]          -> fReclamacoes[Marca]
//   dServico[Servico]          -> fReclamacoes[Servico]
//   dProblema[ChaveProblema]   -> fReclamacoes[ChaveProblema]
// ---------------------------------------------------------------------


// =====================================================================
//  MEDIDAS BASE
// =====================================================================

Solicitações =
SUM ( fReclamacoes[Solicitacoes] )

Reclamações =
CALCULATE ( [Solicitações], fReclamacoes[TipoAtendimento] = "Reclamação" )

% Reclamações no Total =
DIVIDE ( [Reclamações], [Solicitações] )

Média Mensal de Reclamações =
AVERAGEX ( VALUES ( dCalendario[AnoMes] ), [Reclamações] )


// =====================================================================
//  INTELIGÊNCIA DE TEMPO
// =====================================================================

Reclamações Ano Anterior =
CALCULATE ( [Reclamações], SAMEPERIODLASTYEAR ( dCalendario[Data] ) )

Var % Ano a Ano =
VAR _Atual = [Reclamações]
VAR _Anterior = [Reclamações Ano Anterior]
RETURN
    IF ( NOT ISBLANK ( _Anterior ), DIVIDE ( _Atual - _Anterior, _Anterior ) )

Reclamações Acumulado no Ano =
TOTALYTD ( [Reclamações], dCalendario[Data] )

Reclamações Média Móvel 3M =
VAR _UltimaData = MAX ( dCalendario[Data] )
RETURN
    CALCULATE (
        AVERAGEX ( VALUES ( dCalendario[AnoMes] ), [Reclamações] ),
        DATESINPERIOD ( dCalendario[Data], _UltimaData, -3, MONTH )
    )


// =====================================================================
//  QUALIDADE DO ATENDIMENTO
//  Reaberta = o consumidor voltou a reclamar porque o problema não foi resolvido.
// =====================================================================

Reclamações Reabertas =
CALCULATE ( [Reclamações], fReclamacoes[Condicao] = "Reaberta" )

Taxa de Reabertura =
DIVIDE ( [Reclamações Reabertas], [Reclamações] )

Taxa de Reabertura Mercado =
CALCULATE ( [Taxa de Reabertura], REMOVEFILTERS ( dOperadora ) )

Reabertura vs Mercado (p.p.) =
[Taxa de Reabertura] - [Taxa de Reabertura Mercado]


// =====================================================================
//  OPERADORAS
// =====================================================================

Participação nas Reclamações =
DIVIDE ( [Reclamações], CALCULATE ( [Reclamações], REMOVEFILTERS ( dOperadora ) ) )

Ranking Operadora =
IF (
    HASONEVALUE ( dOperadora[Marca] ),
    RANKX ( ALLSELECTED ( dOperadora[Marca] ), [Reclamações], , DESC, DENSE )
)


// =====================================================================
//  PROBLEMAS
// =====================================================================

Principal Problema =
MAXX (
    TOPN ( 1, VALUES ( dProblema[Problema] ), [Reclamações], DESC ),
    dProblema[Problema]
)

Principal Assunto =
MAXX (
    TOPN ( 1, VALUES ( dProblema[Assunto] ), [Reclamações], DESC ),
    dProblema[Assunto]
)

% do Assunto no Total =
DIVIDE ( [Reclamações], CALCULATE ( [Reclamações], REMOVEFILTERS ( dProblema ) ) )


// =====================================================================
//  TEXTOS DINÂMICOS (títulos-mensagem para os cartões e páginas)
// =====================================================================

Título Variação =
VAR _Var = [Var % Ano a Ano]
RETURN
    IF (
        ISBLANK ( _Var ),
        "Sem base de comparação com o ano anterior",
        "Reclamações " & IF ( _Var < 0, "caíram ", "subiram " )
            & FORMAT ( ABS ( _Var ), "0.0%" ) & " em relação ao ano anterior"
    )

Título Principal Problema =
"Principal motivo de reclamação: " & [Principal Problema]
    & " (" & FORMAT ( CALCULATE ( [% do Assunto no Total], TOPN ( 1, VALUES ( dProblema[Problema] ), [Reclamações], DESC ) ), "0.0%" ) & ")"

Período Selecionado =
FORMAT ( MIN ( fReclamacoes[Data] ), "mmm/yyyy" ) & " a " & FORMAT ( MAX ( fReclamacoes[Data] ), "mmm/yyyy" )


// =====================================================================
//  FORMATAÇÃO CONDICIONAL
// =====================================================================

Cor Variação =
IF ( [Var % Ano a Ano] < 0, "#2E9E6B", "#D64545" )   // queda = verde, alta = vermelho
